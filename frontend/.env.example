# Copy to frontend/.env.local and fill in.

# Supabase: Project Settings > API Keys (or the Connect button).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# (older projects can use the legacy anon key here instead)

# Leave empty locally (Vite proxies /api to http://127.0.0.1:8000).
# On Vercel, set to your Render backend URL, e.g. https://clearview-api.onrender.com
VITE_API_URL=
