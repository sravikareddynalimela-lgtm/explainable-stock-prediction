# Copy to backend/.env and fill in.

# Supabase project URL (Project Settings > API Keys / Connect button).
# Leave empty to run the API without login checks (local experiments only).
SUPABASE_URL=https://<project-ref>.supabase.co

# Only for older Supabase projects still on the legacy JWT secret
# (Project Settings > JWT Keys). New projects verify via public keys and don't need this.
SUPABASE_JWT_SECRET=

# Emails allowed to retrain the model through the API (comma-separated).
ADMIN_EMAILS=

# yahoo = live data. demo = simulated prices (offline only).
DATA_SOURCE=yahoo

# Allowed frontend origins (comma-separated). * is fine locally.
CORS_ORIGINS=*
